{
  "info": {
    "name": "RepairMatch API — entrega DBP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección generada desde postman/collections. Contiene los endpoints disponibles y ejemplos ilustrativos, no respuestas de producción. Configurar baseUrl. JWT y refresh tokens deben permanecer vacíos al versionar. Ver docs/RUBRIC_IDENTITY.md y docs/AUTHORIZATION.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "clientEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "technicianEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "json_web_token_043d",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "RepairMatch -Registro #3",
      "description": "Ejecutar en orden. Los casos de permisos requieren los datos H2 descritos en docs/AUTHORIZATION.md.",
      "item": [
        {
          "name": "01 - Registrar cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"clientEmail\", \"cliente-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"No expone contraseñas\", () => { const b = pm.response.json(); pm.expect(b).not.to.have.property(\"password\"); pm.expect(b).not.to.have.property(\"passwordHash\"); });",
                  "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
                  "pm.test(\"Cuenta y rol correctos\", () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys(\"id\", \"name\", \"email\", \"role\"); pm.expect(b.id).to.match(/^[0-9a-f-]{36}$/i); pm.expect(b.role).to.eql(\"CLIENT\"); pm.expect(b.email).to.eql(pm.collectionVariables.get(\"clientEmail\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
